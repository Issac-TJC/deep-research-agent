# Copy to .env. Never commit real credentials. Live providers never fall back to fixtures.
RESEARCH_MODE=live
DEEPSEEK_API_KEY=
MEMORY_API_KEY=
MEMORY_BASE_URL=https://api.deepseek.com
MEMORY_MODEL=
MEMORY_INPUT_USD_PER_MILLION=0.30
MEMORY_OUTPUT_USD_PER_MILLION=1.20
MEMORY_JOB_MAX_INPUT_TOKENS=8000
MEMORY_JOB_MAX_OUTPUT_TOKENS=2000
MEMORY_JOB_MAX_USD=0.05
MEMORY_CHECKPOINT_KEEP=1000
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_EFFORT=low
TAVILY_API_KEY=
# Optional scholarly metadata connector identity and keys. No paid model is used by connector smoke tests.
ACADEMIC_CONTACT_EMAIL=
ACADEMIC_CONNECTOR_TIMEOUT=12
ACADEMIC_CONNECTOR_ATTEMPTS=2
ACADEMIC_CANDIDATES_PER_CONNECTOR=20
OPENALEX_API_KEY=
NCBI_API_KEY=
EMBEDDING_URL=http://localhost:18002
EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
EMBEDDING_REVISION=9bbca17
RETRIEVAL_SHADOW=false
# Conservative peak, cache-miss rates; update and version before a live campaign.
MODEL_INPUT_USD_PER_MILLION=0.30
MODEL_OUTPUT_USD_PER_MILLION=1.20
MODEL_CACHE_USD_PER_MILLION=0.006
SEARCH_USD_PER_CALL=0.01
LIVE_CAMPAIGN_USD=10
DATABASE_URL=postgresql://research_app:research_local@localhost:15432/research
ADMIN_DATABASE_URL=postgresql://postgres:postgres_local@localhost:15432/research
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=research_minio
S3_SECRET_KEY=research_minio_local_secret
S3_BUCKET=research-artifacts
API_ORIGIN=http://localhost:18000
# Demo keys are generated with `research seed`; use the printed keys in the UI.
